{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/review-result.schema.json",
  "title": "S7 Canonical ReviewResult",
  "description": "The single structured result one Assignment submits (L3-S7 §3.5). claim_results must equal the Assignment's Claim set exactly; every fail Claim references a Finding with a real encounter. Submitted via `loop-harness runtime review-result submit`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "assignment_id",
    "review_plan_id",
    "review_round",
    "baseline_generation",
    "producer_agent_id",
    "subject_digest",
    "claim_results",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^review-result-[A-Za-z0-9._-]+$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^assignment-[A-Za-z0-9._-]+$"
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan-[A-Za-z0-9._-]+$"
    },
    "review_round": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 0
    },
    "producer_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 over the ReviewPlan's frozen_subjects (sorted path:sha256 lines). The submit verb recomputes and rejects drift."
    },
    "verification_artifact_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "E2E cold_start only: digest of the spec/fixture/evidence revision actually used. Null when no verification workspace exists."
    },
    "claim_results": {
      "type": "array",
      "minItems": 1,
      "description": "Exactly the Assignment's Claim set — no missing entries, no extras. not_applicable is a ReviewPlan disposition, never a Reviewer conclusion.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "conclusion", "observed"],
        "properties": {
          "claim_id": {"type": "string"},
          "conclusion": {
            "enum": ["pass", "fail"]
          },
          "method": {"type": "string"},
          "observed": {
            "type": "string",
            "minLength": 1,
            "description": "What the Reviewer actually observed for this Claim."
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string", "minLength": 1},
          "result": {
            "enum": ["pass", "fail"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "One Finding per fail Claim, each with a real encounter (see finding.schema.json).",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "deviations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verdict": {
      "enum": ["pass", "finding", "req_change_required", "release_blocked"],
      "description": "Drives automatic routing: pass/finding continue the round; req_change_required/release_blocked create one authoritative pause checkpoint in the submit transaction (L3-S7 §9.2)."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "finding"}}},
      "then": {"properties": {"findings": {"minItems": 1}}}
    }
  ]
}
